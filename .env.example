# Copy this file to .env and fill in local values.
# Never commit .env to GitHub.

# LLM
QWEN_API_KEY=YOUR_QWEN_API_KEY_HERE
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Jimeng / Volcengine visual API
JIMENG_Access_Key_ID=YOUR_JIMENG_ACCESS_KEY_ID_HERE
JIMENG_SECRET_Acess_Key=YOUR_JIMENG_SECRET_ACCESS_KEY_HERE
JIMENG_BASE_URL=https://visual.volcengineapi.com

# Jimeng image generation
JIMENG_IMAGE_MODEL=high_aes_general_v30l_zt2i
JIMENG_IMAGE_WIDTH=1024
JIMENG_IMAGE_HEIGHT=1024
JIMENG_IMAGE_SCALE=3.5
JIMENG_IMAGE_STEPS=25
JIMENG_IMAGE_USE_LLM=true
JIMENG_IMAGE_RETURN_URL=true
IMAGE_COUNT=1

# Jimeng model-card generation
JIMENG_MODELCARD_MODEL=jimeng_t2i_v40
JIMENG_MODELCARD_WIDTH=1024
JIMENG_MODELCARD_HEIGHT=1024
JIMENG_MODELCARD_SCALE=4.0
JIMENG_MODELCARD_STEPS=30
# Separate three absolute local paths with semicolons.
MODELCARD_SILHOUETTE_PATHS=YOUR_PATH_TO_SILHOUETTE_1;YOUR_PATH_TO_SILHOUETTE_2;YOUR_PATH_TO_SILHOUETTE_3

# Jimeng video generation
JIMENG_VIDEO_MODEL=jimeng_i2v_first_tail_v30_1080
JIMENG_VIDEO_WIDTH=1920
JIMENG_VIDEO_HEIGHT=1080
SCENE_MIN_DURATION=5
SCENE_MAX_DURATION=10

# OmniHuman video
OMNI_VIDEO_MODEL=jimeng_realman_avatar_picture_omni_v15
OMNI_OUTPUT_RESOLUTION=1080
OMNI_FAST_MODE=false

# TTS
TTS_APP_ID=YOUR_TTS_APP_ID_HERE
TTS_ACCESS_TOKEN=YOUR_TTS_ACCESS_TOKEN_HERE
TTS_CLUSTER=volcano_tts
TTS_URL=https://openspeech.bytedance.com/api/v1/tts
TTS_DEFAULT_VOICE=BV700_V2_streaming

# TOS object storage
TOS_REGION=cn-beijing
TOS_BUCKET=YOUR_TOS_BUCKET_NAME_HERE
TOS_ENDPOINT=tos-cn-beijing.volces.com

# Local CLI video engine
CLI_DREAMINA_PATH=dreamina
CLI_VIDEO_TIMEOUT=600

# Workflow runtime
VIDEO_ENGINE=omni
OUTPUT_DIR=YOUR_OUTPUT_DIRECTORY_PATH_HERE
